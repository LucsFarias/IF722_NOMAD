@startuml

class Person{
name: String
}

class Participant{
}

class Author{
}

class Theater{
location: String
}

class Session{
timeBegin: int
timeEnd: int
}

class Play{
name: String
time: Time 
}

class Musical

class Opera

enum Time{
Day
Night
}

Person <|-- Participant
Person <|-- Author

Theater "*" -- "*" Play
