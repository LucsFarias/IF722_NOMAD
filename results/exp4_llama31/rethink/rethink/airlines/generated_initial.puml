@startuml
class Airline {
  + name: String
  + city: string
  + operating_cost: float
}
class Airport {
  + code: String
  + city: String
  + operating_cost: float
}
class AirportAirlineRelation {
  + airline: Airline
  + airport: Airport
  + operatingCost: OperatingCost
  + city: string
}
class OperatingCost {
  + cost: Number
  + city: string
}
Airline "*" -- "*" Airport
Airline "1" *-- "1" OperatingCost
Airport "*" -- "*" AirportAirlineRelation
@enduml