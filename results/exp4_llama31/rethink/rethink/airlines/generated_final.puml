@startuml
class Airline {
  + name: String
}
class Airport {
  + code: String
  + city: String
}
class AirportAirlineRelation {
  + airline: Airline
  + airport: Airport
  + operatingCost: OperatingCost
}
class OperatingCost {
  + cost: Number
}
Airline "*" -- "*" Airport
Airline "1" *-- "1" OperatingCost
Airport "*" -- "*" AirportAirlineRelation
@enduml