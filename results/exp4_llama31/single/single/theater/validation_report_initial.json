      "issue_id": "issue-1",
      "severity": "critical",
      "category": "class",
      "message": "The 'Person' class has a method attribute 'name', which should be a field.",
      "responsible_agent": "concept",
      "target": "PlantUML",
      "evidence": "In the requirements, it is stated that authors and participants are persons. This implies that they have attributes, not methods.",
      "suggestions": [
